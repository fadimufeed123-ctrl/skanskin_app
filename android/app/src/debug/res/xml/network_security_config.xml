<?xml version="1.0" encoding="utf-8"?>
<!-- Development-only override. It allows a physical Android device to reach
     the API on the developer machine over the local LAN (for example
     http://192.168.1.20:5093). The main/release configuration remains strict. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
